# Postgres. On Vercel this comes from the Prisma Postgres integration.
DATABASE_URL="postgresql://USER@localhost:5432/prismscore_dev"

# Signs session cookies. Required in production (32+ characters):
#   openssl rand -hex 32
AUTH_SECRET=""

# Model for course generation, via Vercel AI Gateway. On Vercel the gateway
# authenticates with the project's OIDC token; locally run `vercel env pull`
# (VERCEL_OIDC_TOKEN) or set AI_GATEWAY_API_KEY.
AI_MODEL="google/gemini-2.5-flash"
