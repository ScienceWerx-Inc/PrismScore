# Postgres. On Vercel this comes from the Prisma Postgres integration.
DATABASE_URL="postgresql://USER@localhost:5432/prismscore_dev"

# Signs session cookies. Required in production (32+ characters):
#   openssl rand -hex 32
AUTH_SECRET=""

# Course generation calls the Gemini API directly. Use the ScienceWerx Google
# AI Studio key (MoreWerx's SWX_GENAI_KEY). AI_MODEL is optional.
GOOGLE_GENERATIVE_AI_API_KEY=""
AI_MODEL="gemini-3.5-flash"

# Public base URL of this deployment (no trailing slash). Used in verification
# email links and in certificate verify links shared with other ScienceWerx apps.
# Defaults: email links use the request's origin; verify links use https://www.prismscore.us.
APP_URL=""

# Transactional email (email verification) goes through MoreWerx's partner email
# API. Without these, nothing is sent; outside production the verification link
# is printed to the server console instead.
MOREWERX_API_URL=""        # e.g. https://<morewerx host>
MOREWERX_PARTNER_KEY=""    # secret

# ScienceWerx Connect v1 (sharing results between ScienceWerx apps by verified email).
# CONNECT_KEY: this app's secret caller key, "swc_" + 43 base64url chars:
#   node -e "console.log('swc_'+require('crypto').randomBytes(32).toString('base64url'))"
CONNECT_KEY=""
# CONNECT_CALLERS (not secret): who may call this app, comma-separated
#   name:sha256hex-of-their-key:scope|scope   scopes: summary, certificates
# e.g. istartup:9f2c…:summary|certificates,founderfit:ab12…:certificates
CONNECT_CALLERS=""
# CONNECT_PEERS (not secret): peers this app calls, comma-separated name=https://base-url.
# Prism School shows iStartup's summary and certificates.
# e.g. istartup=https://istartupscore.com
CONNECT_PEERS=""
