datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

model Company {
  id            String         @id @default(uuid())
  name          String
  industry      String
  sizeBand      String
  country       String
  planStatus    String         @default("FREE") // FREE, PAID
  paymentStatus String         @default("UNPAID") // UNPAID, PAID
  minExecutiveThreshold Int   @default(3)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  users         User[]
  invitations   Invitation[]
  submissions   Submission[]
  payments      Payment[]
  courses       Course[]
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  name             String
  role             String          // ADMIN, EXECUTIVE, STAFF, PLATFORM_ADMIN
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  execRoleTitle    String?         // CEO, CFO, COO, CTO, CMO, CHRO, OTHER
  department       String?         // For 360 staff
  alsoTakesClevel  Boolean         @default(false)
  /// scrypt hash ("scrypt$<salt>$<key>"); null until the person sets a password.
  passwordHash     String?
  /// Bumped on sign-out-everywhere or password change; sessions carry the
  /// version they were issued with and stop working when it no longer matches.
  sessionVersion   Int             @default(0)
  lastSignInAt     DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  submissions      Submission[]
  gapRecords       GapRecord[]
  concernProfiles  ConcernProfile[]
  courses          Course[]
  lessonProgress   LessonProgress[]
  quizAttempts     QuizAttempt[]
  certificates     Certificate[]
}

model Invitation {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String?
  email      String
  role       String    // EXECUTIVE, STAFF
  execRole   String?   // CEO, CFO, COO, CTO, CMO, CHRO, OTHER
  department String?
  token      String    @unique
  status     String    @default("PENDING") // PENDING, SENT, ACCEPTED, EXPIRED
  invitedBy  String
  sentAt     DateTime  @default(now())
  expiresAt  DateTime?

  @@index([companyId])
}

model AssessmentType {
  id          String       @id // COMPANY, CLEVEL, THREE_SIXTY
  name        String
  description String
  version     String       @default("1.0")
  activeFlag  Boolean      @default(true)

  dimensions  Dimension[]
  questions   Question[]
  submissions Submission[]
}

model Dimension {
  id               String         @id // e.g. STRATEGY, USE_VALUE, DATA_TECH, GOVERNANCE, PEOPLE
  assessmentTypeId String
  assessmentType   AssessmentType @relation(fields: [assessmentTypeId], references: [id], onDelete: Cascade)
  name             String
  weight           Float          @default(0.2) // e.g. 0.25 for Strategy
  domain           String?        // For C-level: "Strategic Opportunity", "Risk & Legal", etc.
  description      String?
  order            Int            @default(0)

  questions        Question[]
  gapRecords       GapRecord[]
}

model Question {
  id               String         @id
  assessmentTypeId String
  assessmentType   AssessmentType @relation(fields: [assessmentTypeId], references: [id], onDelete: Cascade)
  dimensionId      String
  dimension        Dimension      @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  layer            String?        // KNOWLEDGE, AWARENESS, RESISTANCE
  text             String
  scenarioContext  String?
  order            Int
  roleFilter       String?        // ALL, CEO, CFO, COO, CTO, CMO, CHRO

  options          Option[]
  responses        Response[]
}

model Option {
  id           String     @id
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text         String
  points       Int        @default(0) // 0 to 3 for company assessment
  mappedLevel  String?    // UNAWARE, AWARE, PRACTICING, PROFICIENT, LEADING
  concernType  String?    // RISK_LIABILITY, LOSS_OF_CONTROL, DOUBT_ABOUT_RETURN, ROLE_JOB_IMPACT, DATA_SECURITY, ETHICS, LACK_OF_TIME, PAST_BAD_EXP
  order        Int        @default(0)

  responses    Response[]
}

model Submission {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assessmentTypeId String
  assessmentType   AssessmentType @relation(fields: [assessmentTypeId], references: [id], onDelete: Cascade)
  version          String         @default("1.0")
  status           String         @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  startedAt        DateTime       @default(now())
  completedAt      DateTime?

  responses        Response[]
  result           Result?

  @@index([companyId])
  @@index([userId])
}

model Response {
  id           String     @id @default(uuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId     String
  option       Option     @relation(fields: [optionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([submissionId, questionId])
}

model Result {
  id                      String     @id @default(uuid())
  submissionId            String     @unique
  submission              Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  totalScore              Float      // 0 to 500
  band                    String     // UNAWARE, EXPLORING, ESTABLISHED, AI_LED
  perDimensionPercentages String     // JSON object { STRATEGY: 80, ... }
  strengths               String     // JSON array of strings
  gaps                    String     // JSON array of strings
  priorityActions         String     // JSON array of objects { title, why, nextStep, impact }
  createdAt               DateTime   @default(now())
}

model GapRecord {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dimensionId  String
  dimension    Dimension @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  currentLevel String    // UNAWARE, AWARE, PRACTICING, PROFICIENT, LEADING
  targetLevel  String    // UNAWARE, AWARE, PRACTICING, PROFICIENT, LEADING
  gap          Int       // numeric difference: target - current
  priority     String    // HIGH, MEDIUM, LOW
  createdAt    DateTime  @default(now())
}

model ConcernProfile {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concernType String   // RISK_LIABILITY, LOSS_OF_CONTROL, DOUBT_ABOUT_RETURN, ROLE_JOB_IMPACT, DATA_SECURITY, ETHICS, LACK_OF_TIME, PAST_BAD_EXP
  strength    Float    // 0.0 to 1.0 or frequency count
  notes       String?
  createdAt   DateTime @default(now())
}

model Payment {
  id                String   @id @default(uuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  amount            Int      @default(149) // USD
  currency          String   @default("USD")
  providerReference String   @default("simulated_charge")
  status            String   @default("COMPLETED")
  createdAt         DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  entity    String
  details   String?
  timestamp DateTime @default(now())
}


// ───────────────────────── Learning: gap-closing courses ─────────────────────────
// A course is generated for one learner from one completed assessment (the
// company assessment for an admin, the C-level diagnostic for an executive).
// Which gaps it covers is decided by code (src/lib/courses/plan.ts); the model
// only writes the outline, lessons and quizzes.

model Course {
  id                 String         @id @default(uuid())
  companyId          String
  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind               String         // COMPANY, EXECUTIVE
  sourceSubmissionId String
  status             String         @default("OUTLINING") // OUTLINING, WRITING, READY, ERROR
  plan               Json           // GapPlan snapshot the course was written from
  title              String?
  subtitle           String?
  description        String?
  error              String?
  stepStartedAt      DateTime?      // lease for the outline step
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  modules            CourseModule[]
  lessons            Lesson[]
  certificates       Certificate[]

  @@unique([userId, sourceSubmissionId])
  @@index([companyId])
}

model CourseModule {
  id       String   @id @default(uuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  key      String
  title    String
  order    Int
  lessons  Lesson[]

  @@index([courseId])
}

model Lesson {
  id          String         @id @default(uuid())
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId    String
  module      CourseModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order       Int            // position across the whole course
  kind        String         // LESSON, QUIZ
  title       String
  brief       String
  focusIds    Json           // gap question ids this lesson closes
  durationMin Int
  isWorkshop  Boolean        @default(false)
  status      String         @default("PENDING") // PENDING, RUNNING, DONE, ERROR
  startedAt   DateTime?
  attempts    Int            @default(0)
  content     Json?          // LessonContent for LESSON
  error       String?

  questions   QuizQuestion[]
  progress    LessonProgress[]
  quizAttempts QuizAttempt[]

  @@index([courseId])
}

model QuizQuestion {
  id               String @id @default(uuid())
  lessonId         String
  lesson           Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order            Int
  type             String // mcq_single, mcq_multi, true_false
  stem             String
  options          Json   // [{ id, label }]
  correctOptionIds Json   // never sent to a browser before the quiz is over
  points           Int
  difficulty       String
  explanation      String

  @@index([lessonId])
}

model LessonProgress {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@id([userId, lessonId])
}

model QuizAttempt {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers   Json
  score     Int
  maxScore  Int
  percent   Int
  passed    Boolean
  createdAt DateTime @default(now())

  @@index([userId, lessonId])
}

model Certificate {
  code        String    @id // PS-XXXXXXXXXX, printed on the certificate and checked at /verify/<code>
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  learnerName String    // snapshots: the certificate states what was true when issued
  courseTitle String
  companyName String
  grade       Int       // average best quiz percent
  issuedAt    DateTime  @default(now())
  revokedAt   DateTime?

  @@unique([courseId, userId])
}

model AiUsage {
  id           String   @id @default(uuid())
  courseId     String?
  kind         String   // outline, lesson, quiz
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  ok           Boolean
  createdAt    DateTime @default(now())

  @@index([courseId])
}
